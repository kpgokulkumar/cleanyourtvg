<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:label="Currency Rates"
        android:icon="@drawable/banner" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".RatesActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <service android:name=".HomeOverlayService" android:exported="true"
            android:label="Currency Rates Home Overlay"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_overlay_service" />
        </service>
        <provider android:name=".CurrencyConfigProvider" android:authorities="${applicationId}.currencyconfig"
            android:exported="true" android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
