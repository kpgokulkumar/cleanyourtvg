<?xml version="1.0" encoding="utf-8"?>
<!-- Settings rows and choices: the one white focus used everywhere; the chosen value carries a hairline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="@dimen/radius_row" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#29FFFFFF" />
            <corners android:radius="@dimen/radius_row" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="@dimen/radius_row" />
        </shape>
    </item>
</selector>
